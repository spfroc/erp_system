DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend

MYSQL_DATABASE=yicai_erp
MYSQL_USER=yicai
MYSQL_PASSWORD=change-me
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_CONN_MAX_AGE=60
# Set this to the RDS CA certificate path when SSL verification is enabled.
# MYSQL_SSL_CA=/run/secrets/rds-ca.pem

REDIS_URL=redis://redis:6379/0
# Celery 默认复用 REDIS_URL；可单独覆盖
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/0
NOTICE_CRAWLER_DIR=/opt/notice_crawler
OCR_SERVICE_URL=http://ocr-service:8100

# center 短信 API（one 上通常是宿主机 artisan serve :8899）
# CENTER_SMS_BASE_URL=http://172.18.0.1:8899/api/sms
# CENTER_SMS_TOKEN=
# CENTER_SMS_DRY_RUN=0

# official-web。生产写入 .env.official。采集配置写在 .env.prod，与后台共用 MYSQL_*。
PORT=5180
BACKEND_URL=http://backend:8000
BACKEND_HTTP_HOST=assist.qlyc.co
DEFAULT_SITE_KEY=qlyc

# notice-crawler。生产与后台共用 .env.prod 里的 MYSQL_*，入口脚本据此生成 NOTICE_DB_URL。
EXTRACTOR_BACKEND=heuristic
CRAWL_INTERVAL_SECONDS=10800
CRAWL_STOP_DUP=5
CRAWL_LOOKBACK_DAYS=2
CRAWL_PAGE_SIZE=20
CRAWL_ATT_LIMIT=100
# 生产出站代理（与供应链采集共用）；本机直连山东商城不通时必填
NOTICE_HTTP_PROXY=socks5h://192.168.0.19:19081
