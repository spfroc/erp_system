# 微信公众平台「认证服务号」配置（不是开放平台开放平台应用）
# 复制到生产 .env.prod / 本机 env 后填写真实值

# 公众号设置 -> 基本配置
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=

# 公众号设置 -> 基本配置 -> 服务器配置（URL 填 https://你的域名/api/wechat/mp/callback/）
WECHAT_MP_TOKEN=
# 若开启消息加解密再填；当前回调按明文 XML 解析，可先留空
WECHAT_MP_AES_KEY=

# 广告与服务 -> 模板消息：选用后的模板 ID
# 当前汇总推送字段：thing1=有N条公告更新了, time2=推送时间, thing3=点击查看消息列表, character_string5=条数
WECHAT_MP_TEMPLATE_ID_NOTICE_DIGEST=

# 网页授权回调（须与公众号「网页授权域名」一致）
# 例：https://your-domain.com/api/wechat/mp/oauth/callback/
WECHAT_MP_OAUTH_REDIRECT_URI=

# 模板消息点击跳转的门户根地址（可选；默认跳到 /#messages 消息列表）
# 例：https://your-domain.com/portal/
WECHAT_MP_PORTAL_NOTICE_URL=
