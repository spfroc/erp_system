# 本机小模型兜底（可提交）。同名变量可被 .env.assistant.local 覆盖。
ASSISTANT_LLM_ENABLED=true
ASSISTANT_LLM_BASE_URL=http://assistant-llm:8080/v1
ASSISTANT_LLM_MODEL=qwen2.5:0.5b
ASSISTANT_LLM_TIMEOUT=30
ASSISTANT_LLM_INTENT_TIMEOUT=15
ASSISTANT_LLM_API_KEY=local

# 企业微信智能助理连接器（MCP Streamable HTTP）。Token 必须在 .env.assistant.local 覆盖。
ASSISTANT_MCP_ENABLED=false
ASSISTANT_MCP_TOKEN=
ASSISTANT_MCP_USER_ID=wecom-mcp
ASSISTANT_MCP_USERNAME=wecom-mcp
# 留空则使用内置只读权限集；排除 navigation/devops 见代码默认
# ASSISTANT_MCP_PERMISSIONS=assistant.use,notice.view,product.view,salesOrder.view,purchaseOrder.view,serviceOrder.view,finance.view,project.view,platformAccount.view,platformAccount.manage,entity.view,entity.create
# ASSISTANT_MCP_EXCLUDE_TOOLS=navigation.find,devops.get_status
# ASSISTANT_MCP_ALLOW_TOOLS=
