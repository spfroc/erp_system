# MySQL
# 复用主项目 MySQL（yicai_erp），只建 notice_* 表，不另建库
# 宿主机访问 docker-compose.dev 的 mysql：127.0.0.1:13306
NOTICE_DB_URL=mysql+pymysql://root:yicai-root@127.0.0.1:13306/yicai_erp?charset=utf8mb4

# 山东商城 / 框架协议
SD_SITE_CODE=sdzfcg
SD_REGION_GUID=1487001
SD_REGION_CODE=370001

# 供应商抓取 crawl-supplier：先登录拿 token，再本地解密
SD_SUPPLIER_LIST_URL=https://ggzyjyzx.shandong.gov.cn:8182/gpmall-basic/api/supplier/v1/ignore/getSupplierByAgreement
SD_STORE_URL=https://ggzyjyzx.shandong.gov.cn:8182/gateway/gpmall-goodslibrary/api/store/v1/ignore/store
SD_ACCOUNT=
SD_PASSWORD=
SD_ACCESS_TOKEN=
QLYC_CAPTCHA_URL=http://verify.qlyc.co/upload_image

# 京东泉易采 / 青慧采（同一套公告接口，不同合同号）
JD_CONTRACT_NUM=VSP-20250526220758
JD_QHC_CONTRACT_NUM=VSP-20251223153455
JD_APP_SOURCE=CLT
JD_IMPERSONATE=chrome131

# 抽取后端：local_gguf（推荐 CPU）/ local_hf / heuristic / api
# heuristic=规则秒级；山东商城有详情 HTML 时始终走 Clinch 表格规则
EXTRACTOR_BACKEND=heuristic
LOCAL_MODEL_PATH=./models/qwen2.5-1.5b-instruct-q4_k_m.gguf
LOCAL_N_CTX=4096
LOCAL_N_GPU_LAYERS=0
LOCAL_MAX_NEW_TOKENS=1024
# local_hf 时使用：auto / cpu / cuda
LOCAL_MODEL_DEVICE=auto

# 仅 EXTRACTOR_BACKEND=api 时需要
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# 附件目录
ATTACHMENT_DIR=./data/attachments

# 抓取限速（秒）
REQUEST_INTERVAL=0.4
